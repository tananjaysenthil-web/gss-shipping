# Any Postgres works: local `postgres://localhost/gss`, or a free hosted one
# (Neon, Render, Railway all have free Postgres tiers).
DATABASE_URL=postgres://localhost:5432/gss

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

PORT=4000

# The frontend origin allowed to send credentialed requests (cookies).
CORS_ORIGIN=http://localhost:5173
