# Which backend powers auth + shipments: 'mock' (default, zero setup),
# 'custom' (server/), or 'supabase' (supabase/).
VITE_BACKEND=supabase

# Only used when VITE_BACKEND=custom.
VITE_API_URL=http://localhost:4000

# Only used when VITE_BACKEND=supabase.
# Project Settings -> API in your Supabase dashboard. The anon/public key is
# safe to expose in client code by design (Row Level Security is what
# actually restricts access) -- never put the service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
